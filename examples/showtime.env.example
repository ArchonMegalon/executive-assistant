# Memorial flagship showtime environment
# Source this on the presentation machine.

export MEMORIAL_FLAGSHIP_BASE_URL="https://myexternalbrain.com"
export MEMORIAL_SHOWTIME_OUTPUT_DIR="/tmp/manfred_showtime"

# Required in production for the public memorial rate limiter.
export EA_PUBLIC_MEMORIAL_RATE_BACKEND="redis"
export EA_PUBLIC_MEMORIAL_REDIS_URL="redis://localhost:6379/0"

# Optional if using FlipLink publishing from this machine.
export FLIPLINK_API_BASE_URL="https://fliplink.me"
export FLIPLINK_CREATE_PATH="/publications"
export FLIPLINK_UPDATE_PATH_TEMPLATE="/publications/{publication_id}"
export FLIPLINK_CUSTOM_DOMAIN="archive.myexternalbrain.com"
# export FLIPLINK_API_KEY="..."
