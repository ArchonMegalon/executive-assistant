EA_PUSHBULLET_DEFAULT_CLIENT=secondary
PUSHBULLET_SECONDARY_EMAIL=secondary.operator@example.test
# Reverse relay example (messages to the secondary operator -> forward to the primary operator):
# PB_TOKEN_PRIMARY=           # optional if you need readiness/health to pass with full client coverage
# PUSHBULLET_PRIMARY_EMAIL=primary.operator@example.test
# Optional alias token for the same primary-operator mailbox:
# PB_TOKEN_PRIMARY_ALIAS=
# PUSHBULLET_PRIMARY_ALIAS_EMAIL=primary.alias@example.test
# EA_PUSHBULLET_DEFAULT_CLIENT=primary
# EA_PUSHBULLET_RELAY_PRIMARY_CLIENT=primary
# EA_PUSHBULLET_RELAY_SECONDARY_CLIENT=secondary
# EA_PUSHBULLET_RELAY_PRIMARY_TO_SECONDARY_PAYPAL_ENABLED=0
# EA_PUSHBULLET_RELAY_SECONDARY_TO_PRIMARY_ALL_ENABLED=1
EA_PUSHBULLET_RELAY_ENABLED=0
EA_PUSHBULLET_RELAY_PRIMARY_CLIENT=default
EA_PUSHBULLET_RELAY_SECONDARY_CLIENT=secondary
EA_SCHEDULER_PUSHBULLET_RELAY_ENABLED=0
EA_SCHEDULER_PUSHBULLET_RELAY_INTERVAL_SECONDS=15

# Stable, least-privilege Cloudflare tunnel peer identity. Keep the fixed IP and
# trusted /32 aligned; the dedicated network prevents Compose start order from
# changing the authority-validation peer after a restart.
EA_PUBLIC_INGRESS_NETWORK_NAME=ea_public_ingress
EA_PUBLIC_INGRESS_SUBNET=172.31.254.0/29
EA_PUBLIC_INGRESS_GATEWAY=172.31.254.1
EA_PUBLIC_INGRESS_CLOUDFLARED_IPV4=172.31.254.2
EA_PUBLIC_INGRESS_API_IPV4=172.31.254.3
EA_PUBLIC_INGRESS_RESPONSES_PROXY_IPV4=172.31.254.5
EA_PUBLIC_INGRESS_TRUSTED_PROXY_CIDRS=172.31.254.2/32

# Dedicated no-retention client credential. Keep this outside git,
# owner/group-readable only (0640 or stricter), and separate from the operator token.
EA_RESPONSES_NO_RETENTION_CLIENT_TOKEN_HOST_FILE=./.ea-runtime-secrets/no_retention_client_token
EA_RESPONSES_NO_RETENTION_CLIENT_PRINCIPAL_ID=
