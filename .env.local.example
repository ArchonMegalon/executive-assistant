CLICKRANK_AI_CHUMMER_RUN_SITE_ID=
CLICKRANK_AI_MYEXTERNALBRAIN_SITE_ID=
BROWSERACT_USERNAME=
BROWSERACT_PASSWORD=

# Optional public memorial pages, served from your configured public memorial origin.
EA_ENABLE_PUBLIC_MEMORIALS=0
EA_MEMORIAL_DATA_HOST_PATH=./memorial_data
EA_PUBLIC_MEMORIAL_DIR=data/public_memorials
PROPERTYQUARRY_PUBLIC_HOSTS=property.example.test,www.property.example.test
PROPERTYQUARRY_PUBLIC_BASE_URL=https://property.example.test
PROPERTYQUARRY_PUBLIC_TOUR_BASE_URL=https://property.example.test/tours

# Generic Gemini CLI adapter
EA_GEMINI_VORTEX_COMMAND=gemini
EA_GEMINI_VORTEX_MODEL=gemini-3.5-flash
EA_GEMINI_VORTEX_TIMEOUT_SECONDS=180
# Prefer non-interactive Gemini API key auth. Use one of these, not both.
EA_GEMINI_VORTEX_API_KEY=
GEMINI_API_KEY=
# Vertex fallback keys require GOOGLE_GENAI_USE_VERTEXAI=true at execution time.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
EA_GEMINI_VORTEX_SELECTION_MODE=round_robin
GOOGLE_API_KEY_FALLBACK_1=

# Responses API upstream coding providers
EA_RESPONSES_DEFAULT_PROFILE=easy
EA_TOOL_SHIM_PLANNER_MODEL=onemin:gpt-4.1-nano
# Cost-aware background model routing. Gemini/Vertex token counts are recorded in
# the provider dispatch ledger; this is cost-pressure telemetry, not invoice truth.
EA_RESPONSES_PROVIDER_ORDER=onemin,gemini_vortex
EA_RESPONSES_FAST_PROVIDER_ORDER=onemin,magixai,gemini_vortex
EA_RESPONSES_CHEAP_PROVIDER_ORDER=onemin,magixai,gemini_vortex
EA_RESPONSES_GROUNDWORK_PROVIDER_ORDER=onemin,magixai,gemini_vortex
EA_RESPONSES_HARD_PROVIDER_ORDER=onemin,magixai,gemini_vortex
EA_RESPONSES_GEMINI_VORTEX_TOKEN_SOFT_CAP_24H=
EA_RESPONSES_GEMINI_VORTEX_TOKEN_SOFT_CAP_WINDOW_SECONDS=
COMFYUI_URL=https://images.example.test
COMFYUI_FALLBACK_TO_ONEMIN=1
# Chummer6 second-pass smart-glasses overlay planning.
# Set CHUMMER6_OVERLAY_VISION_ENABLED=1 when the Ollama endpoint is reachable.
# If CHUMMER6_OLLAMA_URL is blank, the worker and readiness script will also try
# derived /ollama routes on the COMFYUI host.
CHUMMER6_OVERLAY_VISION_ENABLED=0
CHUMMER6_OLLAMA_URL=
CHUMMER6_OVERLAY_VISION_MODEL=llama3.2-vision:11b
CHUMMER6_OLLAMA_AUTO_PULL=1
CHUMMER6_OLLAMA_PROBE_TIMEOUT_SECONDS=3
CHUMMER6_OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
EA_RESPONSES_TIMEOUT_SECONDS=180
EA_RESPONSES_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36
EA_RESPONSES_MAGICX_HEALTH_CHECK=1
EA_RESPONSES_MAGICX_HEALTH_INTERVAL_SECONDS=300
EA_RESPONSES_MAGICX_HEALTH_TIMEOUT_SECONDS=5
EA_RESPONSES_MAGICX_URLS=https://www.aimagicx.com/api/v1/chat/completions,https://www.aimagicx.com/api/v1/chat,https://beta.aimagicx.com/api/v1/chat/completions,https://beta.aimagicx.com/api/v1/chat
EA_RESPONSES_MAGICX_MODELS=inception/mercury-coder,mistralai/codestral-2508,x-ai/grok-code-fast-1,openai/gpt-5.1-codex-mini
EA_RESPONSES_HARD_MAX_ACTIVE_REQUESTS=8
EA_RESPONSES_HARD_QUEUE_TIMEOUT_SECONDS=120
EA_RESPONSES_MAX_OUTPUT_TOKENS_FAST=768
EA_RESPONSES_MAX_OUTPUT_TOKENS_REVIEW=768
EA_RESPONSES_MAX_OUTPUT_TOKENS_HARD=1536
EA_RESPONSES_MAX_OUTPUT_TOKENS_OVERFLOW=512
EA_RESPONSES_ONEMIN_CHAT_URL=https://api.1min.ai/api/chat-with-ai
EA_RESPONSES_ONEMIN_CODE_URL=https://api.1min.ai/api/features
EA_RESPONSES_ONEMIN_INCLUDED_CREDITS_PER_KEY=4000000
EA_RESPONSES_ONEMIN_BONUS_CREDITS_PER_KEY=450000
EA_RESPONSES_ONEMIN_DELETED_KEY_QUARANTINE_SECONDS=86400
EA_RESPONSES_ONEMIN_OWNER_LEDGER_PATH=/config/onemin_slot_owners.json
EA_RESPONSES_ONEMIN_PROBE_MODEL=gpt-4.1-nano
EA_RESPONSES_ONEMIN_PROBE_TIMEOUT_SECONDS=15
EA_RESPONSES_ONEMIN_ACTIVE_SLOTS=all
EA_RESPONSES_ONEMIN_RESERVE_SLOTS=none
EA_RESPONSES_ONEMIN_MAX_REQUESTS_PER_HOUR=120
EA_RESPONSES_ONEMIN_MAX_CREDITS_PER_HOUR=80000
EA_RESPONSES_ONEMIN_MAX_CREDITS_PER_DAY=600000
EA_RESPONSES_ONEMIN_CODE_MODELS=gpt-5,gpt-4o
EA_RESPONSES_ONEMIN_MODELS=gpt-5,gpt-4.1,deepseek-chat,gpt-4.1-nano
EA_RESPONSES_CHATPLAYGROUND_MODELS=
EA_RESPONSES_CHATPLAYGROUND_ROLES=
EA_RESPONSES_CHATPLAYGROUND_TIMEOUT_SECONDS=180

# Survival lane (slow backup path over Gemini CLI + BrowserAct web helpers)
EA_SURVIVAL_ENABLED=1
EA_SURVIVAL_AUTO_ACTIVATE=0
EA_SURVIVAL_ROUTE_ORDER=onemin,chatplayground,gemini_vortex,gemini_web
EA_SURVIVAL_MAX_ACTIVE_REQUESTS=1
EA_SURVIVAL_QUEUE_TIMEOUT_SECONDS=900
EA_SURVIVAL_MAX_OUTPUT_TOKENS=768
EA_SURVIVAL_CACHE_TTL_SECONDS=86400
EA_SURVIVAL_GEMINI_WEB_MODE=thinking
EA_SURVIVAL_GEMINI_WEB_ALLOW_DEEP_THINK=0
EA_SURVIVAL_GEMINI_WEB_TIMEOUT_SECONDS=600
EA_SURVIVAL_CHATPLAYGROUND_SINGLE_ROLE=factuality
EA_SURVIVAL_REFUSE_CLIENT_TOOLS=1
EA_UI_CHALLENGE_COOLDOWN_SECONDS=1800
EA_UI_CHALLENGE_MAX_CONSECUTIVE=2
BROWSERACT_GEMINI_WEB_URL=

# Chummer6 guide runtime overrides can live in `.chummer6_local_policy.json`.
# Use CHUMMER6_LOCAL_POLICY_PATH to point at a shared fleet checkout when needed.
#
# Chummer public-guide materialization path overrides (optional).
CHUMMER_HUB_REGISTRY_PATHS=
CHUMMER_PORTAL_RELEASE_CHANNEL_PATHS=
CHUMMER6_GUIDE_ASSET_SOURCE_PATHS=
CHUMMER6_GUIDE_MEDIA_WORKER_PATHS=
# Tough Tongue AI Tier 4. Keep the real login identities and PAT in private env only.
TOUGH_TONGUE_BASE_URL=https://api.toughtongueai.com/api/public
TOUGH_TONGUE_LOGIN_EMAIL=replace-with-login-email
TOUGH_TONGUE_FORWARDING_EMAIL=replace-with-forwarding-email
TOUGH_TONGUE_ACCOUNT_TIER=4
TOUGH_TONGUE_API_KEY=
EA_TOUGH_TONGUE_ENABLED=0
EA_TOUGH_TONGUE_ACCOUNT_VERIFIED=0
EA_TOUGH_TONGUE_PROVIDER_VERIFIED=0
EA_TOUGH_TONGUE_AUTO_CREATE_SESSIONS=0
EA_TOUGH_TONGUE_ALLOW_OUTBOUND_CALLS=0
EA_TOUGH_TONGUE_ALLOW_MEETING_BOTS=0
EA_TOUGH_TONGUE_ALLOW_PURCHASES=0
EA_TOUGH_TONGUE_ALLOW_PUBLICATION=0
EA_TOUGH_TONGUE_MIN_REMAINING_MINUTES=30
EA_TOUGH_TONGUE_MAX_SESSION_MINUTES=15
