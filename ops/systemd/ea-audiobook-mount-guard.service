[Unit]
Description=Recover stale pCloud and local audiobook mount generations without an AI janitor
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=tibor
Group=tibor
SupplementaryGroups=docker
UMask=0077
TimeoutStartSec=25min
Environment=HOME=/tmp
ExecStartPre=/usr/bin/sha256sum --check --strict --status /etc/ea-audiobook-mount-guard.sha256
ExecStart=/usr/local/libexec/ea-audiobook-mount-guard
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadOnlyPaths=/docker/EA /docker/audiobookshelf /mnt/pcloud
ReadWritePaths=/docker/EA/data/audiobook-mount-guard
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
