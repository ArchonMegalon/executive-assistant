FROM python:3.11-slim@sha256:a01e48f10f90ac3ee65ef6937b9d7c831a3570c81b98d39a547ff09fb359de7f

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl espeak-ng ffmpeg && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --system --uid 10001 --group ea

WORKDIR /app

COPY requirements.txt /app/requirements.txt
COPY requirements.lock /app/requirements.lock
COPY requirements-openvoice.txt /app/requirements-openvoice.txt
RUN pip install --no-cache-dir -r /app/requirements.txt -c /app/requirements.lock && \
    pip install --no-cache-dir -r /app/requirements-openvoice.txt -c /app/requirements.lock

COPY app /app/app
COPY scripts /app/scripts
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && \
    find /app/scripts -maxdepth 1 -type f -name '*.sh' -exec chmod +x {} \; && \
    chown -R ea:ea /app /usr/local/bin/docker-entrypoint.sh

HEALTHCHECK --interval=30s --timeout=15s --start-period=45s --retries=5 \
  CMD ["/bin/sh", "-ec", "port=${OPENVOICE_PORT:-8093}; curl -fsS --connect-timeout 2 --max-time 10 http://127.0.0.1:${port}/health/ready >/dev/null"]

USER ea
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["python", "-m", "app.runner"]
