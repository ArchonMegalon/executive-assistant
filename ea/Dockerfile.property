FROM python:3.12-slim@sha256:c2d8472b831337ab296a8ce652e1ba786e9e3034fc445dc58b50a7f5251f0003

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    espeak-ng \
    ffmpeg \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    libxrender1 \
    libxshmfence1 && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --system --uid 10001 --group ea

WORKDIR /app

COPY . /tmp/src

RUN set -eu; \
    if [ -f /tmp/src/ea/requirements.txt ] && [ -d /tmp/src/ea/app ]; then \
      APP_SRC=/tmp/src/ea; \
    elif [ -f /tmp/src/requirements.txt ] && [ -d /tmp/src/app ]; then \
      APP_SRC=/tmp/src; \
    else \
      echo "application source not found in build context" >&2; \
      exit 1; \
    fi; \
    cp "$APP_SRC/requirements.txt" /app/requirements.txt; \
    cp "$APP_SRC/requirements.lock" /app/requirements.lock; \
    cp -r "$APP_SRC/app" /app/; \
    cp "$APP_SRC/docker-entrypoint.sh" /usr/local/bin/docker-entrypoint.sh; \
    mkdir -p /app/scripts; \
    if [ -d "$APP_SRC/scripts" ]; then \
      for script in "$APP_SRC"/scripts/*; do \
        [ -f "$script" ] || continue; \
        cp "$script" /app/scripts/; \
      done; \
    elif [ -d /tmp/src/scripts ]; then \
      for script in /tmp/src/scripts/*; do \
        [ -f "$script" ] || continue; \
        cp "$script" /app/scripts/; \
      done; \
    fi; \
    chown -R ea:ea /app /usr/local/bin/docker-entrypoint.sh; \
    rm -rf /tmp/src

RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock

RUN chmod +x /usr/local/bin/docker-entrypoint.sh && \
    find /app/scripts -maxdepth 1 -type f -name '*.sh' -exec chmod +x {} \;

USER ea
HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=5 \
  CMD ["/bin/sh", "-ec", "role=${EA_ROLE:-api}; case \"$role\" in worker|scheduler) exit 0 ;; *) curl -fsS --connect-timeout 2 --max-time 10 http://127.0.0.1:8090/health/live >/dev/null ;; esac"]

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["python", "-m", "app.runner"]
