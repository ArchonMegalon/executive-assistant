        ),
        (
            "codex-fleet-tree",
            r"/usr/lib/node_modules/@openai/codex|/node_modules/@openai/codex/|node /usr/bin/codex|codexea status|codexea fleet",
            True,
            5,
            2,
            4,
            "fleet",
        ),
        (
            "test-workers",
            r"/home/tibor/.local/bin/pytest|/usr/bin/python3 .*pytest|(^|[ /])(pytest|vitest|playwright)( |$)",
            False,
            10,
            3,
            None,
            "background",
        ),
        (
            "build-workers",
            r"dotnet (restore|build|test|publish)|MSBuild\.dll|VBCSCompiler|(^|[ /])csc( |$)|csc\.dll|Roslyn/bincore/csc|docker-buildx bake|docker build|npm (run )?(test|build)|pnpm (test|build)|yarn (test|build)",
            True,
            10,
            3,
            None,
            "background",
        ),
        (
            "browser-automation",
            r"chrome-headless-shell|chromium.*--headless|playwright/driver|propertyquarry_.*browser|propertyquarry_live_mobile_surface_smoke.py",
            False,
            10,
            2,
            7,
            "background",
        ),
        (
            "walkthrough-3d-rendering",
            r"3dvista|3d-vista|matterport|walkthrough|walk-through|virtual[ _-]?tour|property_3d|scene_video|video_readiness|render(_|-)job|blender|threejs|three\.js|ffmpeg|chromium.*(webgl|gpu|screenshot|video)|chrome-headless.*(webgl|gpu|screenshot|video)",
            False,
            10,
            2,
            7,
            "background",
        ),
        (
            "source-scans",
            r"(^|[ /])(du|find|updatedb)( .* )?(/docker|/mnt|/var/lib/docker|/var/cache/rclone|/tmp)",
            False,
            15,
            3,
            None,
            "background",
        ),
        (
            "property-batch",
            r"property_scene_video_readiness_report.py|willhaben_property_packet.py|propertyquarry_.*(smoke|gate|report|readiness)",
            True,
            19,
            3,
            None,
            "background",
        ),
        (
            "sidecar-batch",
            r"process_whatsapp_web_session_actions.py",
            False,
            10,
            3,
            None,
            "background",
        ),
        (
            "background-containers",
            r"clickhouse-server|redis-server|postgres:|python -m app\.runner|dotnet Chummer\.|Sonarr|Radarr|Readarr|Lidarr|Prowlarr|jackett|qbittorrent-nox|flaresolverr|Tautulli\.py|flexget|calibre-web|calibre\b|Chaptarr|LazyLibrarian|rreading-glasses|filebrowser|cloudflared|node dist/index\.js|/usr/local/bin/node /app/dist/cluster\.js|ea_responses_proxy\.py",
            False,
            10,
            3,
            None,
            "background",
        ),
    )

    for label, raw_pattern, include_tree, nice_value, io_class, io_priority, cgroup_profile in patterns:
        pattern = re.compile(raw_pattern)
        roots = {int(row["pid"]) for row in rows if _matches(row, pattern)}
        pids = _descendants(roots, children) if include_tree else roots
        _apply(
            label,
            pids,
            nice_value,
            io_class,
            io_priority,
            cgroup_profile,
            protected_pids=propertyquarry_runtime_pids,
        )

    # PropertyQuarry is a live product surface. Keep its API, scheduler, DB, and
    # tunnel out of the host's background batch lane; demote only host-side
    # PropertyQuarry batch scripts below.

    propertyquarry_host_pattern = re.compile(
        r"propertyquarry|property_quarry|property_scene_|willhaben_property_"
    )
    propertyquarry_host_roots = {
        int(row["pid"]) for row in rows if _matches(row, propertyquarry_host_pattern)
    }
    propertyquarry_host_pids = _descendants(propertyquarry_host_roots, children)
    _apply("propertyquarry-host-work", propertyquarry_host_pids, 19, 3, None, "background")
    return 0


